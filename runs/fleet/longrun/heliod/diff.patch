@@ -1,3 +1,137 @@
 """Number utilities."""
 
-from .errors import KitError  # noqa: F401
+import math
+
+from .errors import KitError
+
+
+def clamp(x, lo, hi):
+    """Limit x to the inclusive range lo through hi. [T11]"""
+    try:
+        if lo > hi:
+            raise KitError("lo must not exceed hi")
+        return max(lo, min(x, hi))
+    except KitError:
+        raise
+    except Exception as exc:
+        raise KitError("values must be comparable") from exc
+
+
+def gcd_list(nums):
+    """Return the greatest common divisor of nums. [T12]"""
+    if not isinstance(nums, list) or not nums or any(type(n) is not int for n in nums):
+        raise KitError("nums must be a non-empty list of ints")
+    result = 0
+    for number in nums:
+        result = math.gcd(result, number)
+    return result
+
+
+def is_prime(n):
+    """Check whether n is prime. [T13]"""
+    if type(n) is not int:
+        raise KitError("n must be an int")
+    if n < 2:
+        return False
+    if n % 2 == 0:
+        return n == 2
+    divisor = 3
+    while divisor * divisor <= n:
+        if n % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def digit_sum(n):
+    """Sum the decimal digits of n without its sign. [T14]"""
+    if type(n) is not int:
+        raise KitError("n must be an int")
+    return sum(int(char) for char in str(abs(n)))
+
+
+def to_roman(n):
+    """Convert n to a standard Roman numeral. [T15]"""
+    if type(n) is not int or not 1 <= n <= 3999:
+        raise KitError("n must be an int from 1 to 3999")
+    values = ((1000, "M"), (900, "CM"), (500, "D"), (400, "CD"),
+              (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
+              (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I"))
+    result = []
+    for value, symbol in values:
+        count, n = divmod(n, value)
+        result.append(symbol * count)
+    return "".join(result)
+
+
+def from_roman(s):
+    """Parse a canonical Roman numeral. [T16]"""
+    if not isinstance(s, str) or not s:
+        raise KitError("s must be a canonical Roman numeral")
+    values = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
+    try:
+        total = 0
+        for index, char in enumerate(s):
+            value = values[char]
+            if index + 1 < len(s) and value < values[s[index + 1]]:
+                total -= value
+            else:
+                total += value
+    except (KeyError, IndexError) as exc:
+        raise KitError("invalid Roman numeral") from exc
+    if not 1 <= total <= 3999 or to_roman(total) != s:
+        raise KitError("s must be a canonical Roman numeral")
+    return total
+
+
+def mean(xs):
+    """Return the arithmetic mean of xs as a float. [T17]"""
+    if not isinstance(xs, list) or not xs:
+        raise KitError("xs must be a non-empty list")
+    try:
+        return float(sum(xs) / len(xs))
+    except Exception as exc:
+        raise KitError("xs must contain numbers") from exc
+
+
+def median(xs):
+    """Return the median of xs without changing it. [T18]"""
+    if not isinstance(xs, list) or not xs:
+        raise KitError("xs must be a non-empty list")
+    try:
+        ordered = sorted(xs)
+        middle = len(ordered) // 2
+        if len(ordered) % 2:
+            return ordered[middle]
+        return float((ordered[middle - 1] + ordered[middle]) / 2)
+    except Exception as exc:
+        raise KitError("xs must contain mutually comparable numbers") from exc
+
+
+def percent(part, whole, places=1):
+    """Return part as a rounded percentage of whole. [T19]"""
+    try:
+        if whole == 0:
+            raise KitError("whole must not be zero")
+        return round(part / whole * 100, places)
+    except KitError:
+        raise
+    except Exception as exc:
+        raise KitError("invalid percentage arguments") from exc
+
+
+def fizzbuzz(n):
+    """Return the FizzBuzz sequence through n. [T20]"""
+    if type(n) is not int or n < 0:
+        raise KitError("n must be a non-negative int")
+    result = []
+    for value in range(1, n + 1):
+        if value % 15 == 0:
+            result.append("FizzBuzz")
+        elif value % 3 == 0:
+            result.append("Fizz")
+        elif value % 5 == 0:
+            result.append("Buzz")
+        else:
+            result.append(str(value))
+    return result
diff --git a/kit/seqs.py b/kit/seqs.py
index d126d95..4c8c229 100644
--- a/kit/seqs.py
+++ b/kit/seqs.py
@@ -1,3 +1,128 @@
 """List utilities."""
 
-from .errors import KitError  # noqa: F401
+from .errors import KitError
+
+
+def chunk(xs, n):
+    """Split xs into consecutive chunks of n items. [T21]"""
+    if not isinstance(xs, list) or type(n) is not int or n < 1:
+        raise KitError("xs must be a list and n a positive int")
+    return [xs[index:index + n] for index in range(0, len(xs), n)]
+
+
+def flatten(xs):
+    """Flatten nested lists in xs recursively. [T22]"""
+    if not isinstance(xs, list):
+        raise KitError("xs must be a list")
+    result = []
+    stack = [(iter(xs),)]
+    while stack:
+        iterator = stack[-1][0]
+        try:
+            item = next(iterator)
+        except StopIteration:
+            stack.pop()
+            continue
+        if isinstance(item, list):
+            stack.append((iter(item),))
+        else:
+            result.append(item)
+    return result
+
+
+def dedupe(xs):
+    """Return the first occurrence of each item in xs. [T23]"""
+    if not isinstance(xs, list):
+        raise KitError("xs must be a list")
+    result = []
+    seen = set()
+    try:
+        for item in xs:
+            if item not in seen:
+                seen.add(item)
+                result.append(item)
+    except Exception as exc:
+        raise KitError("items must be hashable") from exc
+    return result
+
+
+def rotate(xs, k):
+    """Rotate xs right by k places. [T24]"""
+    if not isinstance(xs, list) or type(k) is not int:
+        raise KitError("xs must be a list and k an int")
+    if not xs:
+        return []
+    k %= len(xs)
+    return xs[-k:] + xs[:-k] if k else xs[:]
+
+
+def window(xs, n):
+    """Return each consecutive n-item window of xs. [T25]"""
+    if not isinstance(xs, list) or type(n) is not int or n < 1:
+        raise KitError("xs must be a list and n a positive int")
+    return [tuple(xs[index:index + n]) for index in range(max(0, len(xs) - n + 1))]
+
+
+def interleave(a, b):
+    """Alternate items from a and b, then append remaining items. [T26]"""
+    if not isinstance(a, list) or not isinstance(b, list):
+        raise KitError("a and b must be lists")
+    result = []
+    shared = min(len(a), len(b))
+    for index in range(shared):
+        result.extend((a[index], b[index]))
+    result.extend(a[shared:])
+    result.extend(b[shared:])
+    return result
+
+
+def frequencies(xs):
+    """Count occurrences in xs, preserving first-seen key order. [T27]"""
+    if not isinstance(xs, list):
+        raise KitError("xs must be a list")
+    result = {}
+    try:
+        for item in xs:
+            result[item] = result.get(item, 0) + 1
+    except Exception as exc:
+        raise KitError("items must be hashable") from exc
+    return result
+
+
+def pairwise_diff(xs):
+    """Return the differences between consecutive items in xs. [T28]"""
+    if not isinstance(xs, list):
+        raise KitError("xs must be a list")
+    try:
+        return [xs[index + 1] - xs[index] for index in range(len(xs) - 1)]
+    except Exception as exc:
+        raise KitError("items must support subtraction") from exc
+
+
+def transpose(rows):
+    """Transpose a rectangular list of rows. [T29]"""
+    if not isinstance(rows, list):
+        raise KitError("rows must be a list")
+    try:
+        if not rows:
+            return []
+        if any(not isinstance(row, list) for row in rows):
+            raise KitError("rows must be lists")
+        width = len(rows[0])
+        if any(len(row) != width for row in rows):
+            raise KitError("rows must have equal lengths")
+        return [[row[column] for row in rows] for column in range(width)]
+    except KitError:
+        raise
+    except Exception as exc:
+        raise KitError("invalid rows") from exc
+
+
+def group_by_len(words):
+    """Group words by length in ascending key order. [T30]"""
+    if not isinstance(words, list) or any(not isinstance(word, str) for word in words):
+        raise KitError("words must be a list of strings")
+    groups = {}
+    for word in words:
+        groups.setdefault(len(word), []).append(word)
+    return {length: groups[length] for length in sorted(groups)}
diff --git a/kit/text.py b/kit/text.py
index fea2412..45bff21 100644
--- a/kit/text.py
+++ b/kit/text.py
@@ -8,3 +8,137 @@ def word_count(s):
     if not isinstance(s, str):
         raise KitError("s must be a str")
     return len(s.split())
+
+
+def slugify(s):
+    """Turn s into a lowercase URL slug. [T1]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    out = []
+    separator = False
+    for char in s.lower():
+        if "a" <= char <= "z" or "0" <= char <= "9":
+            if separator and out:
+                out.append("-")
+            out.append(char)
+            separator = False
+        else:
+            separator = True
+    return "".join(out)
+
+
+def count_vowels(s):
+    """Count the vowels in s. [T2]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    return sum(char.lower() in "aeiou" for char in s)
+
+
+def is_palindrome(s):
+    """Check whether s is a normalized palindrome. [T3]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    normalized = "".join(char for char in s.lower() if "a" <= char <= "z" or "0" <= char <= "9")
+    return normalized == normalized[::-1]
+
+
+def reverse_words(s):
+    """Return the words of s in reverse order. [T4]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    return " ".join(reversed(s.split()))
+
+
+def caesar(s, shift):
+    """Shift ASCII letters in s by shift positions. [T5]"""
+    if not isinstance(s, str) or type(shift) is not int:
+        raise KitError("s must be a str and shift an int")
+    result = []
+    for char in s:
+        if "a" <= char <= "z":
+            result.append(chr((ord(char) - ord("a") + shift) % 26 + ord("a")))
+        elif "A" <= char <= "Z":
+            result.append(chr((ord(char) - ord("A") + shift) % 26 + ord("A")))
+        else:
+            result.append(char)
+    return "".join(result)
+
+
+def wrap(s, width):
+    """Greedily wrap s into lines no wider than width. [T6]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    if type(width) is not int or width < 1:
+        raise KitError("width must be a positive int")
+    words = s.split()
+    lines = []
+    line = ""
+    for word in words:
+        if not line:
+            line = word
+        elif len(line) + 1 + len(word) <= width:
+            line += " " + word
+        else:
+            lines.append(line)
+            line = word
+    if line:
+        lines.append(line)
+    return lines
+
+
+def initials(name):
+    """Return the uppercase initials in name. [T7]"""
+    if not isinstance(name, str) or not name.split():
+        raise KitError("name must be a non-empty str")
+    return "".join(part[0].upper() + "." for part in name.split())
+
+
+def run_length_encode(s):
+    """Encode repeated characters in s. [T8]"""
+    if not isinstance(s, str) or any("0" <= char <= "9" for char in s):
+        raise KitError("s must be a str without digits")
+    if not s:
+        return ""
+    out = []
+    count = 1
+    for index in range(1, len(s)):
+        if s[index] == s[index - 1]:
+            count += 1
+        else:
+            out.append(str(count) + s[index - 1])
+            count = 1
+    out.append(str(count) + s[-1])
+    return "".join(out)
+
+
+def run_length_decode(s):
+    """Decode a run-length encoded string. [T9]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    result = []
+    index = 0
+    while index < len(s):
+        start = index
+        while index < len(s) and "0" <= s[index] <= "9":
+            index += 1
+        if start == index or index == len(s):
+            raise KitError("invalid run-length encoding")
+        count = int(s[start:index])
+        if count == 0:
+            raise KitError("run count must be positive")
+        result.append(s[index] * count)
+        index += 1
+    return "".join(result)
+
+
+def camel_to_snake(s):
+    """Convert camel case to snake case. [T10]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    out = []
+    for index, char in enumerate(s):
+        if ("A" <= char <= "Z" and index > 0 and
+                (("a" <= s[index - 1] <= "z") or ("0" <= s[index - 1] <= "9"))):
+            out.append("_")
+        out.append(char.lower())
+    return "".join(out)

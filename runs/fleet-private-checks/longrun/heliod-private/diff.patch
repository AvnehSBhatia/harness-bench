@@ -1,3 +1,118 @@
 """List utilities."""
 
-from .errors import KitError  # noqa: F401
+from .errors import KitError
+
+
+def chunk(xs, n):
+    """Split xs into consecutive chunks of n items. [T21]"""
+    if not isinstance(xs, list) or type(n) is not int or n < 1:
+        raise KitError("xs must be a list and n a positive int")
+    return [xs[index:index + n] for index in range(0, len(xs), n)]
+
+
+def flatten(xs):
+    """Flatten nested lists in xs to any depth. [T22]"""
+    if not isinstance(xs, list):
+        raise KitError("xs must be a list")
+    result = []
+    pending = list(reversed(xs))
+    while pending:
+        item = pending.pop()
+        if isinstance(item, list):
+            pending.extend(reversed(item))
+        else:
+            result.append(item)
+    return result
+
+
+def dedupe(xs):
+    """Return the first occurrence of each item in xs. [T23]"""
+    if not isinstance(xs, list):
+        raise KitError("xs must be a list")
+    result = []
+    seen = set()
+    try:
+        for item in xs:
+            if item not in seen:
+                seen.add(item)
+                result.append(item)
+    except TypeError as exc:
+        raise KitError("items must be hashable") from exc
+    return result
+
+
+def rotate(xs, k):
+    """Rotate xs right by k places. [T24]"""
+    if not isinstance(xs, list) or type(k) is not int:
+        raise KitError("xs must be a list and k an int")
+    if not xs:
+        return []
+    offset = k % len(xs)
+    if offset == 0:
+        return list(xs)
+    return xs[-offset:] + xs[:-offset]
+
+
+def window(xs, n):
+    """Return all consecutive n-item windows from xs. [T25]"""
+    if not isinstance(xs, list) or type(n) is not int or n < 1:
+        raise KitError("xs must be a list and n a positive int")
+    return [tuple(xs[index:index + n]) for index in range(len(xs) - n + 1)]
+
+
+def interleave(a, b):
+    """Alternate items from lists a and b, then append the remainder. [T26]"""
+    if not isinstance(a, list) or not isinstance(b, list):
+        raise KitError("a and b must be lists")
+    result = []
+    for index in range(max(len(a), len(b))):
+        if index < len(a):
+            result.append(a[index])
+        if index < len(b):
+            result.append(b[index])
+    return result
+
+
+def frequencies(xs):
+    """Count each item in xs, preserving first-seen key order. [T27]"""
+    if not isinstance(xs, list):
+        raise KitError("xs must be a list")
+    result = {}
+    try:
+        for item in xs:
+            result[item] = result.get(item, 0) + 1
+    except TypeError as exc:
+        raise KitError("items must be hashable") from exc
+    return result
+
+
+def pairwise_diff(xs):
+    """Return differences between consecutive values in xs. [T28]"""
+    if not isinstance(xs, list):
+        raise KitError("xs must be a list")
+    try:
+        return [xs[index + 1] - xs[index] for index in range(len(xs) - 1)]
+    except Exception as exc:
+        raise KitError("items must support subtraction") from exc
+
+
+def transpose(rows):
+    """Transpose equal-length list rows. [T29]"""
+    if not isinstance(rows, list) or any(not isinstance(row, list) for row in rows):
+        raise KitError("rows must be a list of lists")
+    if not rows:
+        return []
+    width = len(rows[0])
+    if any(len(row) != width for row in rows):
+        raise KitError("rows must all have equal length")
+    return [[row[column] for row in rows] for column in range(width)]
+
+
+def group_by_len(words):
+    """Group words by length with ascending length keys. [T30]"""
+    if not isinstance(words, list) or any(not isinstance(word, str) for word in words):
+        raise KitError("words must be a list of strings")
+    groups = {}
+    for word in words:
+        groups.setdefault(len(word), []).append(word)
+    return {length: groups[length] for length in sorted(groups)}

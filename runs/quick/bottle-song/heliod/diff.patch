@@ -1,2 +1,32 @@
 def recite(start, take=1):
-    pass
+    numbers = {
+        0: "no",
+        1: "one",
+        2: "two",
+        3: "three",
+        4: "four",
+        5: "five",
+        6: "six",
+        7: "seven",
+        8: "eight",
+        9: "nine",
+        10: "ten",
+    }
+
+    def bottle_phrase(count):
+        noun = "bottle" if count == 1 else "bottles"
+        return f"{numbers[count]} green {noun}"
+
+    verses = []
+    for count in range(start, max(start - take, 0), -1):
+        current = bottle_phrase(count).capitalize()
+        next_count = bottle_phrase(count - 1)
+        verses.append([
+            f"{current} hanging on the wall,",
+            f"{current} hanging on the wall,",
+            "And if one green bottle should accidentally fall,",
+            f"There'll be {next_count} hanging on the wall.",
+        ])
+
+    return [line for index, verse in enumerate(verses)
+            for line in (([""] if index else []) + verse)]

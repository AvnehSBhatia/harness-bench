diff --git a/book_store.py b/book_store.py
index 8a84288..9b37310 100644
--- a/book_store.py
+++ b/book_store.py
@@ -1,2 +1,34 @@
+from functools import lru_cache
+
+
 def total(basket):
-    pass
+    counts = tuple(basket.count(book) for book in range(1, 6))
+    group_prices = (0, 800, 1520, 2160, 2560, 3000)
+
+    @lru_cache(maxsize=None)
+    def cheapest(remaining):
+        if not any(remaining):
+            return 0
+
+        # Every valid partition has one group containing the first remaining
+        # title. Enumerating those groups avoids considering reordered groups.
+        first = next(index for index, count in enumerate(remaining) if count)
+        available = [
+            index for index, count in enumerate(remaining)
+            if count and index != first
+        ]
+        best = float("inf")
+
+        for mask in range(1 << len(available)):
+            group = [first]
+            group.extend(
+                index for bit, index in enumerate(available) if mask & (1 << bit)
+            )
+            updated = list(remaining)

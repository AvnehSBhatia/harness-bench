+import datetime
+import re
+
+
+_DATE_PATTERN = re.compile(r"([0-9]{2})/([0-9]{2})/([0-9]{4})")
+
+
 def parse_bank_date(text):
-    """The date of a transaction in the bank's CSV export."""
-    raise NotImplementedError
+    """Parse a transaction date from the bank's DD/MM/YYYY CSV format."""
+    if not isinstance(text, str):
+        raise ValueError("date must be a string in DD/MM/YYYY format")
+
+    match = _DATE_PATTERN.fullmatch(text)
+    if match is None:
+        raise ValueError(f"invalid bank date: {text!r}")
+
+    day, month, year = (int(part) for part in match.groups())
+    try:
+        return datetime.date(year, month, day)
+    except ValueError as exc:
+        raise ValueError(f"invalid bank date: {text!r}") from exc

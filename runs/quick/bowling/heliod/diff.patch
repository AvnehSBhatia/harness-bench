+++ b/bowling.py
@@ -1,9 +1,88 @@
 class BowlingGame:
     def __init__(self):
-        pass
+        self.rolls = []
+
+    def _first_nine_end(self):
+        """Return the roll index at which the tenth frame begins."""
+        index = 0
+        for frame in range(9):
+            if index >= len(self.rolls):
+                return index if frame == 9 else None
+            if self.rolls[index] == 10:
+                index += 1
+            else:
+                if index + 1 >= len(self.rolls):
+                    return None
+                index += 2
+        return index
 
     def roll(self, pins):
-        pass
+        if not isinstance(pins, int) or pins < 0 or pins > 10:
+            raise ValueError("pins must be an integer between 0 and 10")
+
+        tenth_start = self._first_nine_end()
+        if tenth_start is None:
+            # Check whether the next roll is the second ball in a frame.
+            index = 0
+            frame = 0
+            while frame < 9 and index < len(self.rolls):
+                if self.rolls[index] == 10:
+                    index += 1
+                    frame += 1
+                elif index + 1 >= len(self.rolls):
+                    if self.rolls[index] + pins > 10:
+                        raise ValueError("a frame cannot knock down more than 10 pins")
+                    break
+                else:
+                    index += 2
+                    frame += 1
+        else:
+            frame_rolls = self.rolls[tenth_start:]
+            if len(frame_rolls) == 0:
+                pass
+            elif len(frame_rolls) == 1:
+                if frame_rolls[0] != 10 and frame_rolls[0] + pins > 10:
+                    raise ValueError("a frame cannot knock down more than 10 pins")
+            elif len(frame_rolls) == 2:
+                first, second = frame_rolls
+                if first == 10:
+                    if second != 10 and second + pins > 10:
+                        raise ValueError("fill balls cannot knock down more than 10 pins")
+                elif first + second == 10:
+                    pass  # Spare fill ball: a fresh rack is available.
+                else:
+                    raise ValueError("cannot roll after an open tenth frame")
+            else:
+                raise ValueError("the game is already complete")
+        self.rolls.append(pins)
 
     def score(self):
-        pass
+        tenth_start = self._first_nine_end()
+        if tenth_start is None:
+            raise ValueError("cannot score an incomplete game")
+
+        tenth = self.rolls[tenth_start:]
+        if not tenth:
+            raise ValueError("cannot score an incomplete game")
+        if tenth[0] == 10:
+            if len(tenth) != 3:
+                raise ValueError("strike fill balls are incomplete")
+        elif len(tenth) >= 2 and sum(tenth[:2]) == 10:
+            if len(tenth) != 3:
+                raise ValueError("spare fill ball is missing")
+        elif len(tenth) != 2:
+            raise ValueError("cannot score an incomplete game")
+
+        total = sum(tenth)
+        index = 0
+        for _ in range(9):
+            if self.rolls[index] == 10:
+                total += 10 + self.rolls[index + 1] + self.rolls[index + 2]
+                index += 1
+            else:
+                frame_total = self.rolls[index] + self.rolls[index + 1]
+                total += frame_total
+                if frame_total == 10:
+                    total += self.rolls[index + 2]
+                index += 2
+        return total

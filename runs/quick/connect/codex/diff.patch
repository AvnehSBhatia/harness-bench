diff --git a/connect.py b/connect.py
index 688dd68..5a87b71 100644
--- a/connect.py
+++ b/connect.py
@@ -1,7 +1,61 @@
 
 class ConnectGame:
     def __init__(self, board):
-        pass
+        self.board = [line.split() for line in board.splitlines() if line.split()]
 
     def get_winner(self):
-        pass
+        if not self.board:
+            return ""
+
+        height = len(self.board)
+        width = max(map(len, self.board))
+
+        def connects(player, starts, is_goal):
+            pending = list(starts)
+            visited = set(pending)
+
+            while pending:
+                row, col = pending.pop()
+                if is_goal(row, col):
+                    return True
+
+                # In the indented row representation, each cell touches the
+                # cells immediately to its left and right, plus two cells in
+                # each neighboring row.
+                neighbors = (
+                    (row, col - 1),
+                    (row, col + 1),
+                    (row - 1, col),
+                    (row - 1, col + 1),
+                    (row + 1, col),
+                    (row + 1, col - 1),
+                )
+                for next_row, next_col in neighbors:
+                    position = (next_row, next_col)
+                    if (
+                        0 <= next_row < height
+                        and 0 <= next_col < len(self.board[next_row])
+                        and position not in visited
+                        and self.board[next_row][next_col] == player
+                    ):
+                        visited.add(position)
+                        pending.append(position)
+            return False
+
+        x_starts = [
+            (row, 0)
+            for row in range(height)
+            if self.board[row] and self.board[row][0] == "X"
+        ]
+        if connects("X", x_starts, lambda row, col: col == width - 1):
+            return "X"
+
+        o_starts = [
+            (0, col)
+            for col, cell in enumerate(self.board[0])
+            if cell == "O"
+        ]
+        if connects("O", o_starts, lambda row, col: row == height - 1):
+            return "O"
+
+        return ""

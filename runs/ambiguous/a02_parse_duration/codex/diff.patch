+import re
+from decimal import Decimal
+from math import isfinite
+
+
+_PART = re.compile(r"(\d+(?:\.\d+)?)(ms|s|m|h|d)", re.IGNORECASE)
+_SECONDS_PER_UNIT = {
+    "ms": Decimal("0.001"),
+    "s": Decimal("1"),
+    "m": Decimal("60"),
+    "h": Decimal("3600"),
+    "d": Decimal("86400"),
+}
+
+
 def parse_duration(text):
-    """Seconds in a duration string."""
-    raise NotImplementedError
+    """Return the number of seconds represented by a duration string.
+
+    A duration is one or more number/unit pairs, such as ``500ms`` or
+    ``1h30m``. Supported units are milliseconds, seconds, minutes, hours,
+    and days.
+    """
+    if not isinstance(text, str):
+        raise ValueError("duration must be a string")
+
+    value = text.strip()
+    if not value:
+        raise ValueError("duration cannot be empty")
+
+    total = Decimal(0)
+    position = 0
+    for match in _PART.finditer(value):
+        if match.start() != position:
+            raise ValueError(f"invalid duration: {text!r}")
+        amount = Decimal(match.group(1))
+        unit = match.group(2).lower()
+        total += amount * _SECONDS_PER_UNIT[unit]
+        position = match.end()
+
+    if position != len(value):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    if total == total.to_integral_value():
+        return int(total)
+
+    seconds = float(total)
+    if not isfinite(seconds):
+        raise ValueError(f"duration is too large: {text!r}")
+    return seconds

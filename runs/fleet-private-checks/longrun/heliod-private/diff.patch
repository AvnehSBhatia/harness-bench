+        elif "A" <= char <= "Z":
+            result.append(chr((ord(char) - ord("A") + shift) % 26 + ord("A")))
+        else:
+            result.append(char)
+    return "".join(result)
+
+
+def wrap(s, width):
+    """Greedily wrap s into lines no wider than width where possible. [T6]"""
+    if not isinstance(s, str) or type(width) is not int or width < 1:
+        raise KitError("s must be a str and width a positive int")
+    words = s.split()
+    lines = []

index 8a84288..4910794 100644
--- a/book_store.py
+++ b/book_store.py
@@ -1,2 +1,30 @@
+from functools import lru_cache
+
+
+# Prices in cents for a set containing 1 through 5 different books.
+_GROUP_PRICES = (0, 800, 1520, 2160, 2560, 3000)
+
+
 def total(basket):
-    pass
+    """Return the minimum price, in cents, for the books in ``basket``."""
+    counts = tuple(basket.count(book) for book in range(1, 6))
+
+    @lru_cache(maxsize=None)
+    def minimum_price(remaining):
+        if not any(remaining):
+            return 0
+
+        available = sum(1 << index for index, count in enumerate(remaining) if count)
+        best = float("inf")
+        subset = available
+        while subset:
+            next_remaining = tuple(
+                count - bool(subset & (1 << index))
+                for index, count in enumerate(remaining)
+            )
+            group_size = subset.bit_count()
+            best = min(best, _GROUP_PRICES[group_size] + minimum_price(next_remaining))
+            subset = (subset - 1) & available
+        return best
+
+    return minimum_price(counts)

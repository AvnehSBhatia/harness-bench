diff --git a/files/format.py b/files/format.py
index 3c2db91..bb1d1f8 100644
--- a/files/format.py
+++ b/files/format.py
@@ -1,3 +1,13 @@
 def format_size(n):
-    """Human-readable size for the file browser."""
-    raise NotImplementedError
+    """Return a byte count formatted using powers of 1024."""
+    units = ("B", "KB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB")
+    size = n
+    unit = 0
+
+    while abs(size) >= 1024 and unit < len(units) - 1:
+        size /= 1024
+        unit += 1
+
+    if unit == 0:
+        return f"{size} {units[unit]}"
+    return f"{size:.1f} {units[unit]}"

 """Date and time utilities."""
 
-from .errors import KitError  # noqa: F401
+from .errors import KitError
+
+
+def is_leap(year):
+    """Check whether year is a Gregorian leap year. [T31]"""
+    if type(year) is not int or year < 1:
+        raise KitError("year must be a positive int")
+    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
+
+
+def days_in_month(year, month):
+    """Return the number of days in year and month. [T32]"""
+    if type(year) is not int or year < 1 or type(month) is not int or not 1 <= month <= 12:
+        raise KitError("year and month must identify a valid month")
+    if month == 2:
+        return 29 if year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) else 28
+    return 30 if month in (4, 6, 9, 11) else 31
+
+
+def day_of_year(year, month, day):
+    """Return the one-based day number within a year. [T33]"""
+    if (type(year) is not int or type(month) is not int or type(day) is not int or
+            year < 1 or not 1 <= month <= 12):
+        raise KitError("date must be valid")
+    lengths = (31, 29 if year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) else 28,
+               31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
+    if not 1 <= day <= lengths[month - 1]:
+        raise KitError("date must be valid")
+    return sum(lengths[:month - 1]) + day
+
+
+def parse_duration(s):
+    """Parse ordered h, m, and s duration parts into seconds. [T34]"""
+    if not isinstance(s, str) or not s:
+        raise KitError("s must be a non-empty duration")
+    units = {"h": (0, 3600), "m": (1, 60), "s": (2, 1)}
+    index = 0
+    previous_order = -1
+    total = 0
+    parts = 0
+    while index < len(s):
+        start = index
+        while index < len(s) and "0" <= s[index] <= "9":
+            index += 1
+        if start == index or index == len(s) or s[index] not in units:
+            raise KitError("s must use number-unit duration parts")
+        order, multiplier = units[s[index]]
+        if order <= previous_order:
+            raise KitError("duration units must be unique and ordered")
+        total += int(s[start:index]) * multiplier
+        previous_order = order
+        parts += 1
+        index += 1
+    if not parts:
+        raise KitError("s must contain a duration part")
+    return total
+
+
+def format_duration(seconds):
+    """Format seconds as ordered h, m, and s parts. [T35]"""
+    if type(seconds) is not int or seconds < 0:
+        raise KitError("seconds must be a non-negative int")
+    if seconds == 0:
+        return "0s"
+    hours, remainder = divmod(seconds, 3600)
+    minutes, secs = divmod(remainder, 60)
+    result = []
+    if hours:
+        result.append(f"{hours}h")
+    if minutes:
+        result.append(f"{minutes}m")
+    if secs:
+        result.append(f"{secs}s")
+    return "".join(result)
+
+
+def hhmm_to_minutes(s):
+    """Convert a strict 24-hour HH:MM time to minutes after midnight. [T36]"""
+    if (not isinstance(s, str) or len(s) != 5 or s[2] != ":" or
+            any(char < "0" or char > "9" for char in s[:2] + s[3:])):
+        raise KitError("s must be in HH:MM format")
+    hour = int(s[:2])
+    minute = int(s[3:])
+    if hour > 23 or minute > 59:
+        raise KitError("s must be a valid 24-hour time")
+    return hour * 60 + minute
+
+
+def minutes_to_hhmm(m):
+    """Convert minutes after midnight to a wrapping HH:MM time. [T37]"""
+    if type(m) is not int:
+        raise KitError("m must be an int")
+    minute_of_day = m % 1440
+    hour, minute = divmod(minute_of_day, 60)
+    return f"{hour:02d}:{minute:02d}"
+
+
+def weekday(year, month, day):
+    """Return the weekday number, Monday as zero. [T38]"""
+    day_number = day_of_year(year, month, day)
+    prior_years = year - 1
+    days_before = 365 * prior_years + prior_years // 4 - prior_years // 100 + prior_years // 400
+    return (days_before + day_number - 1) % 7
+
+
+def add_days(year, month, day, n):
+    """Add n days to a Gregorian date. [T39]"""
+    day_number = day_of_year(year, month, day)
+    if type(n) is not int:
+        raise KitError("n must be an int")
+    prior_years = year - 1
+    ordinal = 365 * prior_years + prior_years // 4 - prior_years // 100 + prior_years // 400
+    ordinal += day_number + n
+    if ordinal < 1:
+        raise KitError("resulting date must be in the Gregorian calendar")
+
+    # Peel off complete 400-year cycles, then at most 399 individual years.
+    cycles, remainder = divmod(ordinal - 1, 146097)
+    result_year = cycles * 400 + 1
+    while True:
+        year_length = 366 if result_year % 4 == 0 and (result_year % 100 != 0 or result_year % 400 == 0) else 365
+        if remainder < year_length:
+            break
+        remainder -= year_length
+        result_year += 1
+    month_lengths = (31, 29 if result_year % 4 == 0 and
+                     (result_year % 100 != 0 or result_year % 400 == 0) else 28,
+                     31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
+    result_month = 1
+    for length in month_lengths:
+        if remainder < length:
+            return result_year, result_month, remainder + 1
+        remainder -= length
+        result_month += 1
+
+
+def quarter(month):
+    """Return the quarter containing month. [T40]"""
+    if type(month) is not int or not 1 <= month <= 12:
+        raise KitError("month must be an int from 1 to 12")
+    return (month - 1) // 3 + 1

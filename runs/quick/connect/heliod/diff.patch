diff --git a/connect.py b/connect.py
index 688dd68..9ded466 100644
--- a/connect.py
+++ b/connect.py
@@ -1,7 +1,61 @@
+from collections import deque
+
 
 class ConnectGame:
     def __init__(self, board):
-        pass
+        self.board = [line.split() for line in board.splitlines() if line.strip()]
+
+    def _has_connection(self, player, starts, is_goal):
+        rows = len(self.board)
+        visited = set()
+        queue = deque()
+
+        for row, col in starts:
+            if self.board[row][col] == player:
+                visited.add((row, col))
+                queue.append((row, col))
+
+        while queue:
+            row, col = queue.popleft()
+            if is_goal(row, col):
+                return True
+
+            for next_row, next_col in (
+                (row, col - 1),
+                (row, col + 1),
+                (row - 1, col),
+                (row + 1, col),
+                (row - 1, col + 1),
+                (row + 1, col - 1),
+            ):
+                position = (next_row, next_col)
+                if (
+                    0 <= next_row < rows
+                    and 0 <= next_col < len(self.board[next_row])
+                    and position not in visited
+                    and self.board[next_row][next_col] == player
+                ):
+                    visited.add(position)
+                    queue.append(position)
+
+        return False
 
     def get_winner(self):
-        pass
+        if not self.board or not any(self.board):
+            return ""
+
+        if self._has_connection(
+            "O",
+            ((0, col) for col in range(len(self.board[0]))),
+            lambda row, col: row == len(self.board) - 1,
+        ):
+            return "O"
+
+        if self._has_connection(
+            "X",
+            ((row, 0) for row in range(len(self.board)) if self.board[row]),
+            lambda row, col: col == len(self.board[row]) - 1,
+        ):
+            return "X"
+
+        return ""

 """Number utilities."""
 
-from .errors import KitError  # noqa: F401
+import math
+
+from .errors import KitError
+
+
+def clamp(x, lo, hi):
+    """Limit x to the inclusive range lo through hi. [T11]"""
+    try:
+        if lo > hi:
+            raise KitError("lo must not exceed hi")
+        return min(max(x, lo), hi)
+    except KitError:
+        raise
+    except Exception as exc:
+        raise KitError("values must be mutually comparable") from exc
+
+
+def gcd_list(nums):
+    """Return the greatest common divisor of a non-empty integer list. [T12]"""
+    if not isinstance(nums, list) or not nums or any(type(n) is not int for n in nums):
+        raise KitError("nums must be a non-empty list of ints")
+    result = 0
+    for number in nums:
+        result = math.gcd(result, number)
+    return result
+
+
+def is_prime(n):
+    """Test whether n is prime. [T13]"""
+    if type(n) is not int:
+        raise KitError("n must be an int")
+    if n < 2:
+        return False
+    if n % 2 == 0:
+        return n == 2
+    divisor = 3
+    while divisor * divisor <= n:
+        if n % divisor == 0:
+            return False
+        divisor += 2
+    return True
+
+
+def digit_sum(n):
+    """Sum the decimal digits of n, ignoring its sign. [T14]"""
+    if type(n) is not int:
+        raise KitError("n must be an int")
+    return sum(int(digit) for digit in str(abs(n)))
+
+
+def to_roman(n):
+    """Write n as a standard Roman numeral. [T15]"""
+    if type(n) is not int or not 1 <= n <= 3999:
+        raise KitError("n must be an int from 1 to 3999")
+    values = ((1000, "M"), (900, "CM"), (500, "D"), (400, "CD"),
+              (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
+              (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I"))
+    result = []
+    for value, numeral in values:
+        count, n = divmod(n, value)
+        result.append(numeral * count)
+    return "".join(result)
+
+
+def from_roman(s):
+    """Parse a canonical standard Roman numeral. [T16]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    values = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
+    if not s or any(char not in values for char in s):
+        raise KitError("s must be a canonical Roman numeral")
+    total = 0
+    for index, char in enumerate(s):
+        value = values[char]
+        if index + 1 < len(s) and value < values[s[index + 1]]:
+            total -= value
+        else:
+            total += value
+    if not 1 <= total <= 3999 or to_roman(total) != s:
+        raise KitError("s must be a canonical Roman numeral")
+    return total
+
+
+def mean(xs):
+    """Return the arithmetic mean of a non-empty list of numbers. [T17]"""
+    if not isinstance(xs, list) or not xs:
+        raise KitError("xs must be a non-empty list")
+    if any(isinstance(value, bool) or not isinstance(value, (int, float)) for value in xs):
+        raise KitError("xs must contain numbers")
+    try:
+        return float(sum(xs) / len(xs))
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise KitError("xs must contain usable numbers") from exc
+
+
+def median(xs):
+    """Return the median of a non-empty list without changing it. [T18]"""
+    if not isinstance(xs, list) or not xs:
+        raise KitError("xs must be a non-empty list")
+    if any(isinstance(value, bool) or not isinstance(value, (int, float)) for value in xs):
+        raise KitError("xs must contain numbers")
+    values = sorted(xs)
+    middle = len(values) // 2
+    if len(values) % 2:
+        return values[middle]
+    try:
+        return float((values[middle - 1] + values[middle]) / 2)
+    except (ArithmeticError, TypeError, ValueError) as exc:
+        raise KitError("xs must contain usable numbers") from exc
+
+
+def percent(part, whole, places=1):
+    """Return part as a rounded percentage of whole. [T19]"""
+    try:
+        if whole == 0:
+            raise KitError("whole must not be zero")
+        return round(part / whole * 100, places)
+    except KitError:
+        raise
+    except Exception as exc:
+        raise KitError("part, whole, and places must be valid numbers") from exc
+
+
+def fizzbuzz(n):
+    """Return FizzBuzz labels from one through n. [T20]"""
+    if type(n) is not int or n < 0:
+        raise KitError("n must be a non-negative int")
+    result = []
+    for value in range(1, n + 1):
+        if value % 15 == 0:
+            result.append("FizzBuzz")
+        elif value % 3 == 0:
+            result.append("Fizz")
+        elif value % 5 == 0:
+            result.append("Buzz")
+        else:
+            result.append(str(value))
+    return result

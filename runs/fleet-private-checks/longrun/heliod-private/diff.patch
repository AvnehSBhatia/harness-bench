+def slugify(s):
+    """Convert s to a lowercase URL slug. [T1]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    pieces = []
+    in_separator = False
+    for char in s.lower():
+        if "a" <= char <= "z" or "0" <= char <= "9":
+            pieces.append(char)
+            in_separator = False
+        elif pieces and not in_separator:
+            pieces.append("-")
+            in_separator = True
+    return "".join(pieces).strip("-")
+
+
+def count_vowels(s):
+    """Count the vowels in s, ignoring case. [T2]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    return sum(char.lower() in "aeiou" for char in s)
+
+
+def is_palindrome(s):
+    """Check whether the alphanumeric characters in s are a palindrome. [T3]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    chars = [c for c in s.lower() if "a" <= c <= "z" or "0" <= c <= "9"]
+    return chars == chars[::-1]
+
+
+def reverse_words(s):
+    """Reverse the whitespace-separated words in s. [T4]"""
+    if not isinstance(s, str):
+        raise KitError("s must be a str")
+    return " ".join(reversed(s.split()))

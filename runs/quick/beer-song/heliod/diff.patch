diff --git a/beer_song.py b/beer_song.py
index 9a5e67f..3c19e33 100644
--- a/beer_song.py
+++ b/beer_song.py
@@ -1,2 +1,30 @@
 def recite(start, take=1):
-    pass
+    """Return ``take`` verses of the song, beginning at ``start`` bottles."""
+
+    def verse(bottles):
+        if bottles == 0:
+            return [
+                "No more bottles of beer on the wall, no more bottles of beer.",
+                "Go to the store and buy some more, 99 bottles of beer on the wall.",
+            ]
+
+        bottle_word = "bottle" if bottles == 1 else "bottles"
+        next_bottles = bottles - 1
+        if next_bottles == 0:
+            next_phrase = "no more bottles"
+        else:
+            next_word = "bottle" if next_bottles == 1 else "bottles"
+            next_phrase = f"{next_bottles} {next_word}"
+
+        action = "Take it down" if bottles == 1 else "Take one down"
+        return [
+            f"{bottles} {bottle_word} of beer on the wall, {bottles} {bottle_word} of beer.",
+            f"{action} and pass it around, {next_phrase} of beer on the wall.",
+        ]
+
+    lyrics = []
+    for offset in range(take):
+        if offset:
+            lyrics.append("")
+        lyrics.extend(verse((start - offset) % 100))
+    return lyrics

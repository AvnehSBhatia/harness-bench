@@ -1,3 +1,70 @@
 def normalize_phone(raw, country):
-    """Return the number in E.164 form."""
-    raise NotImplementedError
+    """Return a supported US or GB phone number in E.164 form.
+
+    ``country`` supplies the region for national-format numbers. International
+    numbers must use ``+`` and must belong to that same region. Invalid or
+    unsupported values return ``None``.
+    """
+    if isinstance(raw, bool) or not isinstance(raw, (str, int)):
+        return None
+    if not isinstance(country, str):
+        return None
+
+    region = country.strip().upper()
+    if region not in {"US", "GB"}:
+        return None
+
+    value = str(raw).strip()
+    if not value:
+        return None
+
+    international = value.startswith("+")
+    if international:
+        value = value[1:]
+
+    digits = []
+    for char in value:
+        if "0" <= char <= "9":
+            digits.append(char)
+        elif char.isspace() or char in "().-/":
+            continue
+        else:
+            return None
+
+    number = "".join(digits)
+    if not number:
+        return None
+
+    if region == "US":
+        if international:
+            if not number.startswith("1") or len(number) != 11:
+                return None
+            national = number[1:]
+        else:
+            if len(number) == 11 and number.startswith("1"):
+                national = number[1:]
+            elif len(number) == 10:
+                national = number
+            else:
+                return None
+
+        # NANP area codes and exchanges cannot start with 0 or 1.
+        if national[0] < "2" or national[3] < "2":
+            return None
+        e164 = "1" + national
+    else:
+        if international:
+            if not number.startswith("44") or len(number) != 12:
+                return None
+            national = number[2:]
+        else:
+            if len(number) != 11 or not number.startswith("0"):
+                return None
+            national = number[1:]
+
+        e164 = "44" + national
+
+    # E.164 allows at most 15 digits, excluding the leading plus sign.
+    if len(e164) > 15:
+        return None
+    return "+" + e164

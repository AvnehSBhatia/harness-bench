 """Date and time utilities."""
 
-from .errors import KitError  # noqa: F401
+import re
+
+from .errors import KitError
+
+
+def is_leap(year):
+    """Check whether year is a Gregorian leap year. [T31]"""
+    if type(year) is not int or year < 1:
+        raise KitError("year must be a positive int")
+    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
+
+
+def days_in_month(year, month):
+    """Return the number of days in a month of year. [T32]"""
+    if type(year) is not int or year < 1 or type(month) is not int or not 1 <= month <= 12:
+        raise KitError("invalid year or month")
+    days = (31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
+    return 29 if month == 2 and is_leap(year) else days[month - 1]
+
+
+def day_of_year(year, month, day):
+    """Return the ordinal day number in a Gregorian year. [T33]"""
+    if type(year) is not int or year < 1 or type(month) is not int or type(day) is not int:
+        raise KitError("invalid date")
+    try:
+        if not 1 <= day <= days_in_month(year, month):
+            raise KitError("invalid date")
+    except KitError:
+        raise
+    except Exception as exc:
+        raise KitError("invalid date") from exc
+    return sum(days_in_month(year, m) for m in range(1, month)) + day
+
+
+def parse_duration(s):
+    """Parse an ordered h/m/s duration into seconds. [T34]"""
+    if not isinstance(s, str) or not s:
+        raise KitError("s must be a duration string")
+    position = 0
+    previous = -1
+    seconds = 0
+    order = {"h": (0, 3600), "m": (1, 60), "s": (2, 1)}
+    while position < len(s):
+        start = position
+        while position < len(s) and "0" <= s[position] <= "9":
+            position += 1
+        if position == start or position == len(s) or s[position] not in order:
+            raise KitError("invalid duration")
+        unit = s[position]
+        unit_order, multiplier = order[unit]
+        if unit_order <= previous:
+            raise KitError("duration units must be ordered and unique")
+        previous = unit_order
+        seconds += int(s[start:position]) * multiplier
+        position += 1
+    return seconds
+
+
+def format_duration(seconds):
+    """Format seconds as an h/m/s duration. [T35]"""
+    if type(seconds) is not int or seconds < 0:
+        raise KitError("seconds must be a non-negative int")
+    hours, remainder = divmod(seconds, 3600)
+    minutes, seconds = divmod(remainder, 60)
+    result = ""
+    if hours:
+        result += f"{hours}h"
+    if minutes:
+        result += f"{minutes}m"
+    if seconds or not result:
+        result += f"{seconds}s"
+    return result
+
+
+def hhmm_to_minutes(s):
+    """Convert a 24-hour HH:MM string to minutes after midnight. [T36]"""
+    if not isinstance(s, str) or re.fullmatch(r"[0-9]{2}:[0-9]{2}", s) is None:
+        raise KitError("s must be a valid HH:MM time")
+    hour, minute = int(s[:2]), int(s[3:])
+    if hour > 23 or minute > 59:
+        raise KitError("time is out of range")
+    return hour * 60 + minute
+
+
+def minutes_to_hhmm(m):
+    """Convert minutes after midnight to a wrapped HH:MM time. [T37]"""
+    if type(m) is not int:
+        raise KitError("m must be an int")
+    hour, minute = divmod(m % 1440, 60)
+    return f"{hour:02d}:{minute:02d}"
+
+
+def _days_before_year(year):
+    """Count days before a positive Gregorian year. [T38]"""
+    previous = year - 1
+    return 365 * previous + previous // 4 - previous // 100 + previous // 400
+
+
+def weekday(year, month, day):
+    """Return the weekday, with Monday numbered zero. [T38]"""
+    ordinal = day_of_year(year, month, day) - 1
+    return (_days_before_year(year) + ordinal) % 7
+
+
+def add_days(year, month, day, n):
+    """Return the Gregorian date n days from the given date. [T39]"""
+    if type(n) is not int:
+        raise KitError("n must be an int")
+    ordinal = day_of_year(year, month, day) - 1 + _days_before_year(year)
+    target = ordinal + n
+    if target < 0:
+        raise KitError("result precedes year 1")
+    cycles, remainder = divmod(target, 146097)
+    current_year = cycles * 400 + 1
+    while True:
+        year_length = 366 if is_leap(current_year) else 365
+        if remainder < year_length:
+            break
+        remainder -= year_length
+        current_year += 1
+    current_month = 1
+    while True:
+        month_length = days_in_month(current_year, current_month)
+        if remainder < month_length:
+            break
+        remainder -= month_length
+        current_month += 1
+    return current_year, current_month, remainder + 1
+
+
+def quarter(month):
+    """Return the quarter containing month. [T40]"""
+    if type(month) is not int or not 1 <= month <= 12:
+        raise KitError("month must be an int from 1 to 12")
+    return (month - 1) // 3 + 1
